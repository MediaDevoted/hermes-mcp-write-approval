# mcp-write-approval — environment variable template
# Copy to .env and fill in values. Never commit .env.
# All variables are optional; see README.md for full details.

# ----------------------------------------------------------------------------
# Catalog / manifest discovery
# ----------------------------------------------------------------------------

# Comma-separated list of MCP /tools-manifest URLs.
# When set, the plugin fetches tool modes from these endpoints at startup.
# Takes precedence over HERMES_MCP_APPROVAL_CATALOG.
# HERMES_MCP_APPROVAL_MANIFESTS=https://your-mcp-1.example.com/tools-manifest,https://your-mcp-2.example.com/tools-manifest

# Single URL returning a flat JSON list: [{"name":"tool_name","mode":"write|destructive|read"}, ...]
# Used when HERMES_MCP_APPROVAL_MANIFESTS is not set.
# HERMES_MCP_APPROVAL_CATALOG=https://your-catalog.example.com/mcp-tool-modes.json

# Bearer token for authenticated manifest / catalog endpoints.
# HERMES_MCP_APPROVAL_AUTH=your_bearer_token_here

# ----------------------------------------------------------------------------
# Approval timeout
# ----------------------------------------------------------------------------

# Seconds before an unanswered prompt is automatically denied.
# Default: 1200 (20 minutes). Bumped from 5min so async chat surfaces
# (Slack DM threaded replies that don't push-notify on mobile, user away
# from desk, etc.) still have a live prompt when the user comes back.
# HERMES_MCP_APPROVAL_TIMEOUT=1200

# Per-tool override: set HERMES_MCP_APPROVAL_TIMEOUT_<TOOL_NAME_UPCASED> to
# trim noisy / fast-path tools without lowering the global ceiling.
# `:` and `-` in tool names normalise to `_` so the var stays shell-safe.
# HERMES_MCP_APPROVAL_TIMEOUT_VOLUUM_CREATE_OFFER=600
# HERMES_MCP_APPROVAL_TIMEOUT_CLOUDFLARE_PURGE_CACHE=120

# ----------------------------------------------------------------------------
# Push notifications (Slack)
# ----------------------------------------------------------------------------

# Slack user id to @-mention at the start of approval messages and at each
# reminder. Slack does NOT push-notify threaded DM replies by default, but
# DOES push-notify any message containing a directed mention. agent-platform
# fills this from the assistant's owner_slack_user_id when provisioning the
# Hermes VM, so each user is mentioned in their own DM.
# HERMES_APPROVAL_MENTION_USER=U01CVNZK5U7
